{
  "name": "rcugen",
  "version": "1.0.0",
  "description": "Generates OpenAPI and AsyncAPI documents from the Riot Client's /help self-description",
  "main": "dist/cli.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "generate": "npm run build && node --env-file-if-exists=.env dist/cli.js",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "compare-builtin": "npm run build && node --env-file-if-exists=.env dist/tools/compareBuiltin.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "cross-env": "^7.0.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@types/node": "^22.14.1",
    "axios": "^1.8.4"
  }
}
